                    ES_WANTRETURN | ES_NUMBER
    CONTROL         "",IDC_PICT_ALLPAGES,"Static",SS_BLACKFRAME | NOT 
                    WS_VISIBLE,117,12,224,216
    GROUPBOX        "Page Information",IDC_STATIC,346,168,155,102
    LTEXT           "File:",IDC_STATIC,352,181,14,8
    EDITTEXT        IDC_EDIT_CURFILE,373,178,121,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Replace...",IDC_BTN_REPLACE,77,171,37,14
    LTEXT           "Credit:",IDC_STATIC,352,199,21,8
    EDITTEXT        IDC_EDIT_CREDIT,373,196,121,14,ES_AUTOHSCROLL
    LTEXT           "URL:",IDC_STATIC,352,217,18,8
    EDITTEXT        IDC_EDIT_URL,374,214,121,14,ES_AUTOHSCROLL
    LTEXT           "Comments:",IDC_STATIC,352,230,36,8
    EDITTEXT        IDC_EDIT_COMMENT,377,239,119,24,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN
    DEFPUSHBUTTON   "OK",IDOK,386,277,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,448,277,50,14
    CONTROL         "",IDC_PICT_CURPAGE,"Static",SS_BLACKFRAME,346,12,153,
                    153
    PUSHBUTTON      "Remove",IDC_BTN_REMOVE,13,171,36,14
    PUSHBUTTON      "Add...",IDC_BTN_ADD,49,171,27,14
