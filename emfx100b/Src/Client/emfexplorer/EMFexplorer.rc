    PUSHBUTTON      "Top",IDC_BTN_TOP,25,199,37,14
    PUSHBUTTON      "Bottom",IDC_BTN_BOTTOM,62,199,37,14
    PUSHBUTTON      "Left",IDC_BTN_LEFT,25,216,37,14
    PUSHBUTTON      "Right",IDC_BTN_RIGHT,62,216,37,14
    PUSHBUTTON      "Up",IDC_BTN_UP,25,233,37,14
    PUSHBUTTON      "Down",IDC_BTN_DOWN,62,233,37,14
    LTEXT           "Position:",IDC_STATIC,34,254,28,8
